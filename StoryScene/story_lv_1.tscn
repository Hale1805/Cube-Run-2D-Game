[node name="story_lv1" unique_id=1845331984 instance=ExtResource("1_on25y")]
dialogues = Array[String](["Hai mí mắt anh mấp máy, rồi chậm rãi mở dần một cách đầy khó nhọc. “Vẫn đang là nửa đêm”, suy nghĩ đầu tiên chợt hiện lên trong đầu anh khi thấy căn phòng đang chìm trong bóng tối. ", "Chẳng mấy khi anh tỉnh giấc vào giữa đêm như thế này, sẽ là lẽ tự nhiên khi con người ta cảm thấy thắc mắc, nhưng dù có nghĩ đến mấy đi chăng nữa, anh vẫn chẳng thể nào nhớ ra tại sao mình lại tỉnh dậy. ", "Mọi thứ trong anh như trống rỗng, duy chỉ có một cảm giác vẫn âm ỉ len lỏi trong từng thớ cơ của anh. Một cảm giác khó tả, nhưng nếu có thể dùng một từ để diễn giải nó thì anh sẽ nói rằng nó vô cùng “khó chịu”.", "Gượng lại cơn choáng váng, anh cố ổn định lại tinh thần để xem xét tình hình. Và chẳng lâu sau đó, anh đã biết rằng tình trạng của mình còn vượt xa những gì mình tưởng tượng.", "Tứ chi của anh - thứ mà mọi con người bình thường ai cũng phải có, lại không hề xuất hiện trong đôi mắt. Từ góc nhìn của anh, mọi thứ anh thấy chỉ là một mặt phẳng.", "Nhìn xuống, là mặt phẳng, nhìn sang hai bên lại là một góc vuông. Nhìn lên, chỉ có trần nhà xám xịt. Mọi thứ đều bình thường, ngoại trừ anh.", "Player| Cái quái gì thế này? Tay của mình, chân của mình đâu rồi?", "Vừa nói, anh vừa cố cử động những khu vực từng là nơi chứa tay và chân của mình. Nhưng mọi thứ đều vô vọng, anh chả cảm nhận được gì ở đấy cả.", "Cảm giác thật xa lạ, đôi tay, đôi chân đi cùng anh bao năm tháng nay cứ thế biến mất, cuốn theo cái “trí nhớ cơ bắp” về một miền không gian nào đó.", "Nếu như người khác bị tai nạn mất tay hay mất chân, họ vẫn còn biết và có thể cử động phần còn sót lại.", "Nhưng anh thì khác, mặc dù trong đầu vẫn nhớ mình từng có tay chân, nhưng cơ thể anh lại phản ứng như ngay từ ngày đầu tiên sinh ra mình lại chẳng hề có chúng. Chỉ đơn giản là không hề tồn tại.", "Hoảng sợ tột độ, anh bật người dậy. Nhưng mà hỡi ôi, anh làm gì còn chân nữa đâu mà bật dậy.", "Nhưng cũng chính khoảnh khắc đó, anh lại nhận ra một điều: Anh có thể bật nảy.", "Dù không có chân, dù không thể chuyển từ trạng thái nằm thành trạng thái ngồi dậy. Nhưng bằng một cách nào đó vô cùng tự nhiên, anh có thể nảy lên không trung rồi rơi xuống. ", "Ở bất cứ trạng thái nào, chỉ cần muốn là anh có thể bật nảy. Cảm thấy mình có thể di chuyển được, anh định lao ngay ra khỏi giường để tìm hiểu chuyện gì vừa xảy ra với mình. ", "Nhưng chưa kịp làm thế thì một giọng nói ồm ồm xuất hiện trước mặt anh…", "Boss| Hmm, tỉnh rồi sao, đồ chuột nhắt.", "Từ trong góc phòng, một luồng tà khí với áp lực nghẹt thở từ từ hiện ra. Đôi mắt đỏ ngầu của hắn nhìn chằm chằm vào anh đầy chế giễu.", "Player| Ngươi là kẻ nào? Ngươi đã làm gì cơ thể ta? Trả lại nhân dạng cho ta ngay!", "Ngay khi vừa thấy hắn với giọng điệu đó, anh đã biết ngay hắn là kẻ khiến mình trở nên như thế này. Anh lớn tiếng, định lao vào đánh hắn một trận. ", "Nhưng chưa kịp để cho anh làm như thế, hắn đã lôi ra một chiếc gương từ trong hư không, lúc nhìn được bản thể của mình qua gương, anh khựng lại.", "Player| Anh có thể nhìn thấy rõ ràng bản thân của mình lúc này - một khối hộp. Chỉ có thế, anh không là gì khác ngoài khối hộp với đôi mắt và cái miệng ở mặt trước. ", "Còn chưa kịp để cho anh hết ngỡ ngàng, đôi mắt đỏ rực tiếp lời:", "Boss| Ta là ai ư? Người ngoài hành tinh, ma quỷ hay là một kẻ điên, ngươi nghĩ thế nào cũng được.", "Boss| Nhưng ngươi nghĩ đúng ở khoản ai là kẻ biến ngươi thành khối hộp rồi đấy. Phải, chính là ta! Ta chỉ gọt đẽo nó lại cho phù hợp với sự thấp kém của ngươi mà thôi hahaha!", "Player| Tại sao…", "Boss| Nực cười, hỏi gì không hỏi, lại đi hỏi lý lẽ với một thứ không phải con người. Ta cũng không biết giống loài thấp kém như ngươi suy nghĩ cái gì nữa.", "Rồi hắn bỗng dừng lại một nhịp trước khi tiếp tục.", "Boss| Tuy nhiên, ta cũng không phải kẻ vô tình. Nếu muốn lấy lại thân xác con người, hãy chứng minh mình xứng đáng.", "Boss| Hãy vác cái thân hình vuông vức đó tìm đến Núi lửa Ignis, gặp và đánh bại ta ở đó.", "Player| Núi lửa Ignis? Đó là chỗ quái nào, ta còn chả biết nó nằm ở đâu trên Trái Đất? Ngươi nghĩ ta sẽ can tâm làm theo trò tiêu khiển của ngươi chắc?", "Boss| Quyền lựa chọn là ở ngươi thôi. Hoặc là kẹt trong hình hài rác rưởi đó mãi mãi, hoặc là bước ra khỏi cánh cửa kia.", "Vừa nói, hắn vừa chỉ ra cánh cửa phòng anh. Nhưng giờ đây, cái cửa ấy trông xa vời một cách bất thường, hơn thế nữa, giữa anh với cánh cửa, là một rừng các chướng ngại vật không biết xuất hiện từ bao giờ.", "Boss| Hãy cố mà sống sót qua các cạm bẫy nhé, khối vuông bé nhỏ. Ta sẽ đợi ngươi ở nơi sâu nhất của địa ngục.", "Dứt lời, con mắt đỏ rực trông như một sinh vật từ chiều không gian khác ấy biến mất. Để lại anh lạc lõng một mình.", "Anh đứng đó, cố tiêu hóa những gì vừa xảy ra với mình. Mọi thứ diễn ra quá đột ngột, mới mười phút trước anh còn đang chìm trong giấc ngủ. Nhưng bây giờ…", "Liệu đây có phải là sự trừng phạt của Chúa? Hay là một lời nguyền của ác quỷ? Anh không biết.", "Liệu đây có phải là hậu quả của những năm tháng sống không tốt đối với gia đình và xã hội? Có phải anh đã quá lười biếng và coi thường cuộc sống? Anh không biết.", "Nhưng…", "Giờ đây anh đã biết một điều.", "Rằng anh phải thay đổi, rằng anh phải sống sót. Rằng nếu như anh có cơ hội làm lại cuộc đời một lần nữa, đó sẽ là lúc anh trở về hình dáng con người. ", "Player| Được rồi… khốn kiếp! Dù có phải vụn vỡ ra thành từng mảnh, ta cũng sẽ bắt ngươi phải trả giá. Ta sẽ quay về làm người!", "Đó là lúc cuộc hành trình của anh bắt đầu!"])
next_scene_path = "uid://c50kxfi86ya4v"
